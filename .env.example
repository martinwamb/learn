# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://learn_user:your_password@localhost:5432/learn"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-random-secret-here"

# Google OAuth — from Google Cloud Console
# Authorised redirect URI: https://learn.wambugumartin.com/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Next.js ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL="https://learn.wambugumartin.com"
AUTH_TRUST_HOST=true
# NOTE: this PORT value is informational only -- `next start` binds its HTTP server
# before .env is parsed, so the port must also be passed explicitly as `-p 3006` in
# the PM2 start command (see .github/workflows/deploy.yml).
PORT=3006

# ─── TTS (narration) ──────────────────────────────────────────────────────────
# Path to the edge-tts CLI binary (dedicated venv on server, separate from the
# `port` project's own venv). Network-based Microsoft neural TTS, no local CPU
# load and no local model.
EDGE_TTS_BIN="/home/admin/edge-tts-venv/bin/edge-tts"

# ─── TTS Warm Worker ──────────────────────────────────────────────────────────
# Narration is content-addressed and cached to public/audio/tts-cache. This worker
# pre-generates every published lesson/story line overnight so no child ever waits
# on an inline synthesis (measured at ~1s per short line on this box, before the
# browser's own fetch). Cumulative -- successive nights converge, then it no-ops.
# Cap on NEW clips generated per run (already-cached lines cost nothing). Measured at
# ~2.4s/clip at concurrency 3 on this box, so 1200 is about a 50-minute run. Raising it
# means checking it still fits the cron slot (see deploy.yml).
TTS_WARM_MAX_PER_RUN=1200
# Parallel edge-tts spawns. Network-bound, but this box runs six other PM2 apps.
TTS_WARM_CONCURRENCY=3

# ─── Lesson & Story Item Media (illustrations + sound effects) ────────────────
# Iconscout: illustrations/vectors, used for lesson picture-match items and Jina
# story page art. lib/media/iconscout.ts filters to price=free so the automated
# nightly/on-demand lookups never spend paid download credits. Client-ID alone is
# enough for search + direct image embed -- Client-Secret is only needed for
# Iconscout's separate paid "download" flow, not used here.
ICONSCOUT_CLIENT_ID=""
ICONSCOUT_CLIENT_SECRET=""
# Freesound: community-uploaded sound effects -- lib/media/freesound.ts filters
# is_explicit results and restricts to Attribution/CC0 licenses.
FREESOUND_API_KEY=""

# ─── Lesson Generator ─────────────────────────────────────────────────────────
# Ollama endpoint (already running on the Hetzner server)
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"

# Max new lessons generated per unit per nightly run (keep low for CPU servers)
LESSON_GEN_MAX_PER_UNIT=1
# Ceiling on total lessons generated across ALL units in one run, regardless of how
# many units are below target -- keeps nightly Ollama load flat as curriculum grows.
LESSON_GEN_MAX_TOTAL_PER_RUN=8

# ─── Faith Lesson Generator ────────────────────────────────────────────────────
# Independent budget from LESSON_GEN_MAX_TOTAL_PER_RUN above, so neither worker
# starves the other. Generated lessons save as status="draft" for admin review at
# /admin/faith-review before publishing -- kept low since there's no benefit
# generating drafts faster than a single admin can review them.
FAITH_LESSON_GEN_MAX_TOTAL_PER_RUN=4

# Deliberately heavier than OLLAMA_MODEL above -- confirmed live that qwen2.5:3b
# reliably stopped Bible-story retellings right before their actual turning point
# (e.g. Cain's jealousy, Adam & Eve's disobedience), no matter the prompt wording.
# qwen3:14b with thinking mode (hardcoded on in workers/faith-lesson-generator.ts)
# completes the same stories properly. Slower (~2-4 min/lesson vs under a minute)
# but fine at this volume, inside the nightly window.
FAITH_OLLAMA_MODEL="qwen3:14b"

# Email of the account allowed to see/publish/discard drafts at /admin/cbc-review,
# /admin/faith-review and /admin/story-review (must match the Google account's
# email you sign in with).
ADMIN_EMAIL=""

# ─── Jina Story Generator ──────────────────────────────────────────────────────
# Every unit ships with one hand-authored story (prisma/story-content/*). This
# worker tops each unit up towards Unit.targetStoryCount with further stories, as
# status="draft" for review at /admin/story-review. Kept low: a story takes ~3-5
# minutes to generate, and there's no benefit outpacing the reviewer.
STORY_GEN_MAX_TOTAL_PER_RUN=3

# Same reasoning as FAITH_OLLAMA_MODEL -- a small model abandons a narrative before
# its turning point, and a story whose problem is never resolved is useless as
# reading practice. Thinking mode is hardcoded on in workers/story-generator.ts.
STORY_OLLAMA_MODEL="qwen3:14b"

# ─── Email Reminders ───────────────────────────────────────────────────────────
# Dedicated Mailcow mailbox on the same self-hosted mail server publisher-site
# already sends through (mail.wambugumartin.com:587) -- see lib/email/send.ts.
EMAIL_SMTP_USER="learn@wambugumartin.com"
EMAIL_SMTP_PASS=""
# Days of no activity before an inactivity nudge email is sent
EMAIL_INACTIVE_DAYS=3
